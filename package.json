{
  "name": "ai-agent-office",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "npm run build:server && concurrently -k -n types,server,web \"tsc -p tsconfig.server.json --watch --preserveWatchOutput\" \"node --watch dist/server/index.js\" \"vite --host 127.0.0.1\"",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:server && vite build",
    "check": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "npm run build:server && node --test tests/*.test.mjs src/web/events.test.mjs",
    "start": "node dist/server/index.js",
    "build:launcher": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-launcher.ps1",
    "build:portable": "npm run build && node scripts/build-portable.mjs",
    "test:launcher": "node scripts/test-launcher.mjs",
    "doctor": "npm run build:server && node dist/server/doctor.js"
  },
  "dependencies": {
    "@fastify/static": "10.1.6",
    "@fastify/websocket": "11.3.4",
    "@react-three/fiber": "9.8.2",
    "fastify": "5.12.7",
    "lucide-react": "1.60.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1",
    "zod": "4.6.7",
    "@pixiv/three-vrm": "3.5.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4"
  }
}
